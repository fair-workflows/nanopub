{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
      "local>ashleycaselli/renovate-config:node",
  ],
  "automerge": false,
  "packageRules": [
    {
      "description": "Updates to the dependencies should trigger a new patch release",
      "matchFileNames": [
        "pyproject.toml"
      ],
      "semanticCommitScope": "core-deps"
    }
  ]
}
